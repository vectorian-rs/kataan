---
import '../styles/global.css';

const { title = 'Kataan' } = Astro.props;
---

<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    <div id="app-shell" class="app-shell properties-hidden">
      <slot name="sidebar" />
      <slot name="list" />
      <slot name="content" />
      <slot name="properties" />
    </div>

    <script is:inline>
      const appShell = document.getElementById('app-shell');
      [
        { storageKey: 'kataan:sidebar-width', cssProperty: '--sidebar-width', minWidth: 160, maxWidth: 420 },
        { storageKey: 'kataan:list-width', cssProperty: '--list-width', minWidth: 220, maxWidth: 560 },
        { storageKey: 'kataan:properties-width', cssProperty: '--properties-width', minWidth: 220, maxWidth: 420 },
      ].forEach(({ storageKey, cssProperty, minWidth, maxWidth }) => {
        const savedWidth = Number.parseInt(localStorage.getItem(storageKey) ?? '', 10);
        if (Number.isFinite(savedWidth)) {
          appShell?.style.setProperty(
            cssProperty,
            `${Math.min(maxWidth, Math.max(minWidth, Math.round(savedWidth)))}px`,
          );
        }
      });

      const saved = localStorage.getItem('theme') ?? 'light';
      document.documentElement.dataset.theme = saved;
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('theme', next);
        window.dispatchEvent(new CustomEvent('kataan:theme-change', { detail: { theme: next } }));
      });
    </script>
  </body>
</html>
