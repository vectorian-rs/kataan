---
import { COLUMN_GEOMETRY } from '../lib/columns';
import '../styles/global.css';

const { title = 'Kataan' } = Astro.props;

// Serialized into the inline script below with `define:vars`. That script runs
// before first paint and so cannot be a module — `define:vars` is what lets it
// share the real configuration instead of carrying a hand-matched copy.
const columns = COLUMN_GEOMETRY.map(({ storageKey, cssProperty, minWidth, maxWidth }) => ({
  storageKey,
  cssProperty,
  minWidth,
  maxWidth,
}));
---

<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    <div id="app-shell" class="app-shell properties-hidden">
      <slot name="sidebar" />
      <slot name="list" />
      <slot name="content" />
      <slot name="properties" />
    </div>

    <script is:inline define:vars={{ columns }}>
      // Applies saved widths before first paint, so a resized column does not
      // jump from its default on every load.
      const appShell = document.getElementById('app-shell');
      columns.forEach(({ storageKey, cssProperty, minWidth, maxWidth }) => {
        const savedWidth = Number.parseInt(localStorage.getItem(storageKey) ?? '', 10);
        if (Number.isFinite(savedWidth)) {
          appShell?.style.setProperty(
            cssProperty,
            `${Math.min(maxWidth, Math.max(minWidth, Math.round(savedWidth)))}px`,
          );
        }
      });

      const saved = localStorage.getItem('theme') ?? 'light';
      document.documentElement.dataset.theme = saved;
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('theme', next);
        window.dispatchEvent(new CustomEvent('kataan:theme-change', { detail: { theme: next } }));
      });
    </script>
  </body>
</html>
