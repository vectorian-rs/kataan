---
const title = 'Kataan';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <style>
      :root {
        color-scheme: light dark;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      body {
        margin: 0;
      }

      button {
        cursor: pointer;
      }

      .app {
        display: grid;
        grid-template-columns: 280px 320px 1fr;
        min-height: 100vh;
      }

      .panel {
        border-right: 1px solid color-mix(in srgb, CanvasText 14%, transparent);
        padding: 1rem;
        overflow: auto;
      }

      .main {
        padding: 1rem 1.25rem;
        overflow: auto;
      }

      .toolbar {
        display: flex;
        gap: 0.5rem;
        margin: 1rem 0;
      }

      .list {
        display: grid;
        gap: 0.4rem;
      }

      .item {
        border: 1px solid color-mix(in srgb, CanvasText 14%, transparent);
        border-radius: 0.5rem;
        padding: 0.6rem 0.7rem;
        text-align: left;
        background: transparent;
      }

      .item:hover,
      .item.active {
        background: color-mix(in srgb, CanvasText 8%, transparent);
      }

      .muted {
        color: color-mix(in srgb, CanvasText 60%, transparent);
        font-size: 0.9rem;
      }

      pre {
        border: 1px solid color-mix(in srgb, CanvasText 14%, transparent);
        border-radius: 0.5rem;
        padding: 1rem;
        overflow: auto;
      }

      .diagnostic {
        border-left: 4px solid gray;
        padding: 0.5rem 0.75rem;
        margin: 0.4rem 0;
        background: color-mix(in srgb, CanvasText 6%, transparent);
      }

      .diagnostic.error {
        border-left-color: #dc2626;
      }

      .diagnostic.warning {
        border-left-color: #d97706;
      }

      .diagnostic.info {
        border-left-color: #2563eb;
      }
    </style>
  </head>
  <body>
    <div class="app">
      <aside class="panel">
        <h1>Kataan</h1>
        <p id="vault-summary" class="muted">Loading vault…</p>
        <div class="toolbar">
          <button id="validate-button">Validate</button>
          <button id="rebuild-button">Rebuild</button>
        </div>
        <section>
          <h2>Folders</h2>
          <div id="folders" class="list"></div>
        </section>
        <section>
          <h2>Diagnostics</h2>
          <div id="diagnostics" class="muted">No diagnostics yet.</div>
        </section>
      </aside>

      <aside class="panel">
        <h2 id="folder-title">Documents</h2>
        <div id="documents" class="list muted">Select a folder.</div>
      </aside>

      <main class="main">
        <h2 id="document-title">Document</h2>
        <div id="document-body" class="muted">Select a document.</div>
      </main>
    </div>

    <script>
      import '../lib/dashboard';
    </script>
  </body>
</html>
