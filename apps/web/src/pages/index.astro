---
const title = 'Kataan';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <style>
      @import "https://unpkg.com/open-props";
      @import "https://unpkg.com/open-props/normalize.min.css";

      :root {
        color-scheme: light dark;
        --brand: var(--teal-6);
        --brand-2: var(--blue-6);
        --text-1: light-dark(var(--gray-12), var(--gray-1));
        --text-2: light-dark(var(--gray-7), var(--gray-5));
        --text-3: light-dark(var(--gray-6), var(--gray-6));
        --surface-1: light-dark(#f8f8f7, #101214);
        --surface-2: light-dark(#ffffff, #15181b);
        --surface-3: light-dark(#f1f2f1, #1b1f23);
        --surface-hover: light-dark(#eceeed, #20252a);
        --surface-active: light-dark(#e8f6f1, #163129);
        --border: light-dark(#e4e5e4, #2a2f35);
        --shadow-soft: 0 1px 2px rgb(0 0 0 / 8%);
      }

      html,
      body {
        block-size: 100%;
      }

      body {
        margin: 0;
        color: var(--text-1);
        background: var(--surface-1);
        font-family: Inter, var(--font-sans);
        font-size: 14px;
      }

      button {
        font: inherit;
      }

      button.nav-row,
      button.document-row,
      button.button {
        all: unset;
        box-sizing: border-box;
        cursor: pointer;
        font: inherit;
      }

      .app-shell {
        display: grid;
        grid-template-columns: 240px 360px minmax(520px, 1fr) 300px;
        block-size: 100vh;
        overflow: hidden;
      }

      .sidebar,
      .document-list,
      .reader,
      .properties {
        min-block-size: 0;
        overflow: auto;
        background: var(--surface-2);
      }

      .sidebar,
      .document-list,
      .reader {
        border-inline-end: 1px solid var(--border);
      }

      .sidebar {
        display: grid;
        grid-template-rows: auto 1fr auto;
        background: var(--surface-1);
      }

      .app-header,
      .list-header,
      .reader-header,
      .properties-header {
        display: flex;
        align-items: center;
        min-block-size: 52px;
        padding: 0 16px;
        border-block-end: 1px solid var(--border);
        background: color-mix(in srgb, var(--surface-2) 94%, transparent);
        backdrop-filter: blur(12px);
      }

      .app-header {
        display: block;
        padding-block: 14px;
      }

      .app-title {
        margin: 0;
        font-size: 22px;
        font-weight: 750;
        letter-spacing: -0.03em;
      }

      .app-subtitle,
      .muted {
        color: var(--text-2);
      }

      .app-subtitle {
        margin-block-start: 2px;
        font-size: 13px;
      }

      .section {
        padding: 14px 10px;
      }

      .section + .section {
        border-block-start: 1px solid var(--border);
      }

      .section-title {
        margin: 0 0 8px 8px;
        color: var(--text-3);
        font-size: 11px;
        font-weight: 750;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .list {
        display: grid;
        gap: 2px;
      }

      button.nav-row,
      button.document-row {
        inline-size: 100%;
        border: 0;
        border-radius: 8px;
        background: transparent;
        color: var(--text-1);
        text-align: start;
      }

      button.nav-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        min-block-size: 40px;
        padding: 0 8px;
        font-size: 16px;
        font-weight: 650;
      }

      button.nav-row:hover,
      button.document-row:hover {
        background: color-mix(in srgb, var(--surface-hover) 70%, transparent);
      }

      button.nav-row.active,
      button.document-row.active {
        background: var(--surface-active);
        color: light-dark(var(--teal-8), var(--teal-2));
      }

      .folder-name {
        display: flex;
        align-items: center;
        gap: 12px;
        min-inline-size: 0;
      }

      .folder-icon {
        display: inline-grid;
        flex: 0 0 auto;
        place-items: center;
        color: var(--brand);
      }

      .folder-icon svg {
        inline-size: 19px;
        block-size: 19px;
      }

      .folder-icon.note,
      .folder-icon.raw {
        color: var(--red-5);
      }

      .folder-icon.project {
        color: var(--orange-5);
      }

      .folder-icon.person {
        color: var(--yellow-6);
      }

      .folder-icon.topic,
      .folder-icon.type-definition {
        color: var(--blue-5);
      }

      .badge {
        min-inline-size: 1.85rem;
        border-radius: 999px;
        padding: 2px 8px;
        background: light-dark(#f3f4f6, color-mix(in srgb, var(--gray-9) 72%, transparent));
        color: var(--text-2);
        font-size: 13px;
        font-weight: 600;
        text-align: center;
      }

      .toolbar {
        display: flex;
        gap: 8px;
        padding: 10px;
        border-block-start: 1px solid var(--border);
      }

      button.button {
        display: inline-grid;
        flex: 1;
        place-items: center;
        block-size: 34px;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--surface-2);
        color: var(--text-1);
        box-shadow: var(--shadow-soft);
      }

      button.button.primary {
        border-color: color-mix(in srgb, var(--brand) 55%, transparent);
        background: var(--brand);
        color: white;
      }

      .list-header,
      .reader-header,
      .properties-header {
        position: sticky;
        inset-block-start: 0;
        z-index: 2;
        justify-content: space-between;
      }

      .list-header h2,
      .reader-header h2,
      .properties-header h2 {
        margin: 0;
        font-size: 15px;
        font-weight: 750;
      }

      button.document-row {
        display: grid;
        gap: 4px;
        border-radius: 0;
        border-block-end: 1px solid var(--border);
        padding: 12px 16px;
      }

      .document-row strong {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: 14px;
      }

      .document-row span {
        overflow: hidden;
        color: var(--text-2);
        font-size: 12px;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .reader {
        background: var(--surface-2);
      }

      .reader-body {
        max-inline-size: 760px;
        margin-inline: auto;
        padding: 56px 48px 96px;
        color: var(--text-1);
        font-size: 18px;
        line-height: 1.72;
      }

      .reader-body h1,
      .reader-body h2,
      .reader-body h3 {
        line-height: 1.15;
        letter-spacing: -0.04em;
      }

      .reader-body h1 {
        margin-block: 0 28px;
        border-block-end: 1px solid var(--border);
        padding-block-end: 24px;
        font-size: clamp(2.2rem, 4vw, 3.8rem);
      }

      .reader-body h2 {
        margin-block-start: 44px;
        font-size: 1.65rem;
      }

      .reader-body p,
      .reader-body ul,
      .reader-body ol {
        margin-block: 0 1.1em;
      }

      .reader-body a {
        color: var(--brand);
      }

      .reader-body code {
        border-radius: 5px;
        padding: 0.1em 0.32em;
        background: var(--surface-3);
        font-size: 0.9em;
      }

      .reader-body pre {
        overflow: auto;
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 16px;
        background: light-dark(var(--gray-1), var(--gray-12));
        font-size: 0.9rem;
        line-height: 1.5;
      }

      .empty-state {
        display: grid;
        place-items: center;
        min-block-size: calc(100vh - 52px);
        color: var(--text-2);
        text-align: center;
      }

      .empty-card {
        max-inline-size: 24rem;
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 24px;
        background: var(--surface-2);
        box-shadow: var(--shadow-soft);
      }

      .empty-card strong {
        display: block;
        margin-block-end: 6px;
        color: var(--text-1);
        font-size: 20px;
      }

      .metadata-grid {
        display: grid;
        gap: 0;
      }

      .property {
        display: grid;
        grid-template-columns: 92px minmax(0, 1fr);
        gap: 12px;
        border-block-end: 1px solid var(--border);
        padding: 11px 16px;
      }

      .property-label {
        color: var(--text-3);
        font-size: 11px;
        font-weight: 750;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      .property-value {
        overflow-wrap: anywhere;
        color: var(--text-2);
        font-size: 13px;
      }

      .diagnostic {
        border-inline-start: 3px solid var(--gray-6);
        border-radius: 8px;
        padding: 8px 10px;
        background: var(--surface-2);
        color: var(--text-2);
        font-size: 12px;
      }

      .diagnostic.error {
        border-inline-start-color: var(--red-6);
      }

      .diagnostic.warning {
        border-inline-start-color: var(--orange-6);
      }

      .diagnostic.info {
        border-inline-start-color: var(--blue-6);
      }

      @media (width < 1100px) {
        .app-shell {
          grid-template-columns: 220px 1fr;
        }

        .document-list,
        .properties {
          display: none;
        }
      }
    </style>
  </head>
  <body>
    <div class="app-shell">
      <aside class="sidebar">
        <div>
          <header class="app-header">
            <h1 class="app-title">Kataan</h1>
            <div id="vault-summary" class="app-subtitle">Loading vault…</div>
          </header>

          <section class="section">
            <h2 class="section-title">Folders</h2>
            <div id="folders" class="list"></div>
          </section>

          <section class="section">
            <h2 class="section-title">Diagnostics</h2>
            <div id="diagnostics" class="list muted">No diagnostics yet.</div>
          </section>
        </div>

        <div class="toolbar">
          <button id="validate-button" class="button" type="button">Validate</button>
          <button id="rebuild-button" class="button primary" type="button">Rebuild</button>
        </div>
      </aside>

      <aside class="document-list">
        <header class="list-header">
          <h2 id="folder-title">Documents</h2>
        </header>
        <div id="documents" class="list muted section">Select a folder.</div>
      </aside>

      <main class="reader">
        <header class="reader-header">
          <h2 id="document-title">Document</h2>
          <span class="muted">Read-only</span>
        </header>
        <article id="document-body" class="reader-body empty-state">
          <div class="empty-card">
            <strong>Select a document</strong>
            Choose a folder and document to preview its Markdown content.
          </div>
        </article>
      </main>

      <aside class="properties">
        <header class="properties-header">
          <h2>Properties</h2>
        </header>
        <div id="metadata-panel" class="metadata-grid muted">Select a document.</div>
      </aside>
    </div>

    <script>
      import '../lib/dashboard';
    </script>
  </body>
</html>
