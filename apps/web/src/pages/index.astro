---
const title = 'Kataan';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <style>
      @import "https://unpkg.com/open-props";
      @import "https://unpkg.com/open-props/normalize.min.css";
      @import "https://unpkg.com/open-props/buttons.min.css";

      :root {
        color-scheme: light dark;
        --brand: var(--teal-6);
        --brand-soft: var(--teal-0);
        --text-1: light-dark(var(--gray-12), var(--gray-0));
        --text-2: light-dark(var(--gray-7), var(--gray-4));
        --surface-1: light-dark(var(--gray-0), var(--gray-12));
        --surface-2: light-dark(var(--gray-1), var(--gray-11));
        --surface-3: light-dark(white, var(--gray-10));
        --surface-selected: light-dark(var(--teal-0), color-mix(in srgb, var(--teal-9) 22%, transparent));
        --border: light-dark(var(--gray-3), color-mix(in srgb, var(--gray-7) 45%, transparent));
        --shadow-card: 0 1px 2px color-mix(in srgb, black 8%, transparent);
      }

      body {
        min-block-size: 100vh;
        margin: 0;
        color: var(--text-1);
        background: var(--surface-1);
        font-family: var(--font-sans);
      }

      button {
        font: inherit;
      }

      .app-shell {
        display: grid;
        grid-template-columns: 17rem 23rem minmax(30rem, 1fr) 22rem;
        min-block-size: 100vh;
        overflow: hidden;
      }

      .sidebar,
      .document-list,
      .properties {
        block-size: 100vh;
        overflow: auto;
        border-inline-end: 1px solid var(--border);
        background: var(--surface-2);
      }

      .properties {
        border-inline: 1px solid var(--border) 0;
        background: var(--surface-3);
      }

      .sidebar {
        display: grid;
        grid-template-rows: auto 1fr auto;
      }

      .brand {
        padding: var(--size-5);
        border-block-end: 1px solid var(--border);
      }

      .brand h1 {
        margin: 0;
        font-size: var(--font-size-5);
        letter-spacing: var(--font-letterspacing-0);
      }

      .brand p,
      .muted {
        color: var(--text-2);
      }

      .section {
        padding: var(--size-4);
      }

      .section-title {
        margin-block: 0 var(--size-3);
        color: var(--text-2);
        font-size: var(--font-size-0);
        font-weight: var(--font-weight-7);
        letter-spacing: var(--font-letterspacing-2);
        text-transform: uppercase;
      }

      .toolbar {
        display: flex;
        gap: var(--size-2);
        padding: var(--size-4);
        border-block-start: 1px solid var(--border);
      }

      .button {
        flex: 1;
        min-block-size: 2.35rem;
        border: 1px solid var(--border);
        border-radius: var(--radius-2);
        padding: var(--size-2) var(--size-3);
        background: var(--surface-3);
        color: var(--text-1);
        box-shadow: var(--shadow-card);
      }

      .button.primary {
        border-color: color-mix(in srgb, var(--brand) 50%, transparent);
        background: var(--brand);
        color: white;
      }

      .list {
        display: grid;
        gap: var(--size-1);
      }

      .item {
        inline-size: 100%;
        border: 0;
        border-radius: var(--radius-2);
        padding: 0.55rem 0.7rem;
        background: transparent;
        color: var(--text-1);
        text-align: start;
      }

      .item:hover,
      .item.active {
        background: var(--surface-selected);
      }

      .folder-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--size-3);
        font-weight: var(--font-weight-6);
      }

      .folder-name {
        display: flex;
        align-items: center;
        gap: var(--size-2);
      }

      .folder-icon {
        display: inline-grid;
        place-items: center;
        color: var(--brand);
      }

      .folder-icon svg {
        inline-size: 1rem;
        block-size: 1rem;
      }

      .badge {
        min-inline-size: 2rem;
        border-radius: var(--radius-round);
        padding: 0.15rem 0.5rem;
        background: light-dark(var(--gray-2), var(--gray-9));
        color: var(--text-2);
        font-size: var(--font-size-0);
        text-align: center;
      }

      .document-list-header,
      .properties-header {
        position: sticky;
        inset-block-start: 0;
        z-index: 1;
        padding: var(--size-4);
        border-block-end: 1px solid var(--border);
        background: color-mix(in srgb, var(--surface-3) 92%, transparent);
        backdrop-filter: blur(12px);
      }

      .document-list-header h2,
      .properties-header h2 {
        margin: 0;
        font-size: var(--font-size-2);
      }

      .document-card {
        border-block-end: 1px solid var(--border);
        border-radius: 0;
        padding: var(--size-3) var(--size-4);
      }

      .document-card strong {
        display: block;
        margin-block-end: var(--size-1);
      }

      .reader {
        block-size: 100vh;
        overflow: auto;
        background:
          radial-gradient(circle at top, color-mix(in srgb, var(--brand) 5%, transparent), transparent 24rem),
          var(--surface-3);
      }

      .reader-header {
        position: sticky;
        inset-block-start: 0;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--size-3);
        padding: var(--size-4) var(--size-6);
        border-block-end: 1px solid var(--border);
        background: color-mix(in srgb, var(--surface-3) 90%, transparent);
        backdrop-filter: blur(12px);
      }

      .reader-title {
        margin: 0;
        font-size: var(--font-size-2);
      }

      .reader-body {
        max-inline-size: 54rem;
        margin-inline: auto;
        padding: var(--size-8) var(--size-6);
        font-size: var(--font-size-2);
        line-height: var(--font-lineheight-4);
      }

      .empty-state {
        display: grid;
        place-items: center;
        min-block-size: 40vh;
        color: var(--text-2);
        text-align: center;
      }

      .empty-card {
        max-inline-size: 28rem;
        border: 1px solid var(--border);
        border-radius: var(--radius-3);
        padding: var(--size-6);
        background: color-mix(in srgb, var(--surface-3) 92%, transparent);
        box-shadow: var(--shadow-card);
      }

      .empty-card strong {
        display: block;
        margin-block-end: var(--size-2);
        color: var(--text-1);
        font-size: var(--font-size-3);
      }

      pre {
        overflow: auto;
        border: 1px solid var(--border);
        border-radius: var(--radius-3);
        padding: var(--size-5);
        background: light-dark(white, color-mix(in srgb, var(--gray-11) 82%, black));
        box-shadow: var(--shadow-card);
        white-space: pre-wrap;
      }

      .metadata-grid {
        display: grid;
        gap: var(--size-3);
      }

      .property {
        display: grid;
        gap: var(--size-1);
        border-block-end: 1px solid var(--border);
        padding-block: var(--size-3);
      }

      .property-label {
        color: var(--text-2);
        font-size: var(--font-size-0);
        font-weight: var(--font-weight-7);
        letter-spacing: var(--font-letterspacing-1);
        text-transform: uppercase;
      }

      .property-value {
        overflow-wrap: anywhere;
      }

      .diagnostic {
        border-inline-start: 4px solid var(--gray-6);
        border-radius: var(--radius-2);
        padding: var(--size-3);
        background: light-dark(white, var(--gray-10));
        box-shadow: var(--shadow-card);
      }

      .diagnostic.error {
        border-inline-start-color: var(--red-6);
      }

      .diagnostic.warning {
        border-inline-start-color: var(--orange-6);
      }

      .diagnostic.info {
        border-inline-start-color: var(--blue-6);
      }

      @media (width < 75rem) {
        .app-shell {
          grid-template-columns: 16rem 1fr;
        }

        .document-list,
        .properties {
          display: none;
        }
      }
    </style>
  </head>
  <body>
    <div class="app-shell">
      <aside class="sidebar">
        <div>
          <header class="brand">
            <h1>Kataan</h1>
            <p id="vault-summary">Loading vault…</p>
          </header>

          <section class="section">
            <h2 class="section-title">Folders</h2>
            <div id="folders" class="list"></div>
          </section>

          <section class="section">
            <h2 class="section-title">Diagnostics</h2>
            <div id="diagnostics" class="list muted">No diagnostics yet.</div>
          </section>
        </div>

        <div class="toolbar">
          <button id="validate-button" class="button" type="button">Validate</button>
          <button id="rebuild-button" class="button primary" type="button">Rebuild</button>
        </div>
      </aside>

      <aside class="document-list">
        <header class="document-list-header">
          <h2 id="folder-title">Documents</h2>
        </header>
        <div id="documents" class="list muted section">Select a folder.</div>
      </aside>

      <main class="reader">
        <header class="reader-header">
          <h2 id="document-title" class="reader-title">Document</h2>
          <span class="muted">Read-only preview</span>
        </header>
        <article id="document-body" class="reader-body empty-state">
          <div class="empty-card">
            <strong>Select a document</strong>
            Choose a folder and document to preview its Markdown content.
          </div>
        </article>
      </main>

      <aside class="properties">
        <header class="properties-header">
          <h2>Properties</h2>
        </header>
        <div id="metadata-panel" class="section metadata-grid muted">Select a document.</div>
      </aside>
    </div>

    <script>
      import '../lib/dashboard';
    </script>
  </body>
</html>
