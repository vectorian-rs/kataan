---
const title = 'Kataan';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <style>
      :root {
        color-scheme: light dark;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      body {
        margin: 0;
      }

      button {
        cursor: pointer;
      }

      .app {
        display: grid;
        grid-template-columns: 280px 320px 1fr;
        min-height: 100vh;
      }

      .panel {
        border-right: 1px solid color-mix(in srgb, CanvasText 14%, transparent);
        padding: 1rem;
        overflow: auto;
      }

      .main {
        padding: 1rem 1.25rem;
        overflow: auto;
      }

      .toolbar {
        display: flex;
        gap: 0.5rem;
        margin: 1rem 0;
      }

      .list {
        display: grid;
        gap: 0.4rem;
      }

      .item {
        border: 1px solid color-mix(in srgb, CanvasText 14%, transparent);
        border-radius: 0.5rem;
        padding: 0.6rem 0.7rem;
        text-align: left;
        background: transparent;
      }

      .item:hover,
      .item.active {
        background: color-mix(in srgb, CanvasText 8%, transparent);
      }

      .muted {
        color: color-mix(in srgb, CanvasText 60%, transparent);
        font-size: 0.9rem;
      }

      pre {
        border: 1px solid color-mix(in srgb, CanvasText 14%, transparent);
        border-radius: 0.5rem;
        padding: 1rem;
        overflow: auto;
      }

      .diagnostic {
        border-left: 4px solid gray;
        padding: 0.5rem 0.75rem;
        margin: 0.4rem 0;
        background: color-mix(in srgb, CanvasText 6%, transparent);
      }

      .diagnostic.error {
        border-left-color: #dc2626;
      }

      .diagnostic.warning {
        border-left-color: #d97706;
      }

      .diagnostic.info {
        border-left-color: #2563eb;
      }
    </style>
  </head>
  <body>
    <div class="app">
      <aside class="panel">
        <h1>Kataan</h1>
        <p id="vault-summary" class="muted">Loading vault…</p>
        <div class="toolbar">
          <button id="validate-button">Validate</button>
          <button id="rebuild-button">Rebuild</button>
        </div>
        <section>
          <h2>Folders</h2>
          <div id="folders" class="list"></div>
        </section>
        <section>
          <h2>Diagnostics</h2>
          <div id="diagnostics" class="muted">No diagnostics yet.</div>
        </section>
      </aside>

      <aside class="panel">
        <h2 id="folder-title">Documents</h2>
        <div id="documents" class="list muted">Select a folder.</div>
      </aside>

      <main class="main">
        <h2 id="document-title">Document</h2>
        <div id="document-body" class="muted">Select a document.</div>
      </main>
    </div>

    <script type="module">
      import {
        getDocument,
        getFolder,
        getFolders,
        getVault,
        rebuildIndexes,
        validateVault,
      } from '/src/lib/api.ts';

      const state = {
        selectedFolder: null,
        selectedDocument: null,
      };

      const vaultSummary = document.querySelector('#vault-summary');
      const foldersEl = document.querySelector('#folders');
      const documentsEl = document.querySelector('#documents');
      const diagnosticsEl = document.querySelector('#diagnostics');
      const folderTitle = document.querySelector('#folder-title');
      const documentTitle = document.querySelector('#document-title');
      const documentBody = document.querySelector('#document-body');
      const validateButton = document.querySelector('#validate-button');
      const rebuildButton = document.querySelector('#rebuild-button');

      validateButton.addEventListener('click', async () => {
        const report = await validateVault();
        renderDiagnostics(report);
      });

      rebuildButton.addEventListener('click', async () => {
        await rebuildIndexes();
        await loadFolders();
        const report = await validateVault();
        renderDiagnostics(report);
      });

      await loadVault();
      await loadFolders();

      async function loadVault() {
        const vault = await getVault();
        vaultSummary.textContent = `${vault.name} · schema ${vault.schema_version}`;
      }

      async function loadFolders() {
        const response = await getFolders();
        foldersEl.replaceChildren(
          ...response.folders.map((folder) => {
            const button = document.createElement('button');
            button.className = 'item';
            button.type = 'button';
            button.textContent = `${folder.name ?? folder.folder} (${folder.document_count})`;
            button.addEventListener('click', () => selectFolder(folder.folder));
            return button;
          }),
        );
      }

      async function selectFolder(folder) {
        state.selectedFolder = folder;
        const response = await getFolder(folder);
        folderTitle.textContent = response.index.name;

        if (response.documents.length === 0) {
          documentsEl.className = 'list muted';
          documentsEl.textContent = 'No documents.';
          return;
        }

        documentsEl.className = 'list';
        documentsEl.replaceChildren(
          ...response.documents.map((document) => {
            const button = document.createElement('button');
            button.className = 'item';
            button.type = 'button';
            button.textContent = document.id;
            button.addEventListener('click', () => selectDocument(document.id));
            return button;
          }),
        );
      }

      async function selectDocument(id) {
        state.selectedDocument = id;
        const document = await getDocument(id);
        documentTitle.textContent = document.id;
        documentBody.innerHTML = '';

        const markdown = document.createElement('pre');
        markdown.textContent = document.markdown;

        const metadata = document.createElement('pre');
        metadata.textContent = JSON.stringify(document.metadata, null, 2);

        documentBody.append(markdown, metadata);
      }

      function renderDiagnostics(report) {
        if (report.diagnostics.length === 0) {
          diagnosticsEl.className = 'muted';
          diagnosticsEl.textContent = report.ok ? 'Vault is valid.' : 'No diagnostics.';
          return;
        }

        diagnosticsEl.className = '';
        diagnosticsEl.replaceChildren(
          ...report.diagnostics.map((diagnostic) => {
            const item = document.createElement('div');
            item.className = `diagnostic ${diagnostic.severity}`;
            item.textContent = `${diagnostic.severity.toUpperCase()} [${diagnostic.code}] ${diagnostic.path ?? ''} ${diagnostic.message}`;
            return item;
          }),
        );
      }
    </script>
  </body>
</html>
