<main class="content-pane">
  <div class="content-shell">
    <header class="content-header">
      <div>
        <div id="breadcrumb" class="breadcrumb">No document selected</div>
        <h2 id="document-title" class="panel-title">Document</h2>
      </div>
      <span class="readonly-badge">Read-only</span>
