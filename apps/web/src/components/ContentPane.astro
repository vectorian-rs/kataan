<main class="content-pane">
  <div class="content-shell">
    <header class="content-header">
      <div class="content-header-main">
        <div id="breadcrumb" class="breadcrumb">No document selected</div>
        <h2 id="document-title" class="panel-title visually-hidden">Document</h2>
      </div>
      <div class="content-header-actions">
        <button id="edit-button" class="ui-button button-secondary" type="button" hidden>
          Edit
        </button>
        <button id="save-button" class="ui-button button-primary" type="button" hidden>
          Save
        </button>
        <button id="cancel-button" class="ui-button button-secondary" type="button" hidden>
          Cancel
        </button>
        <button
          id="list-toggle"
          class="ui-button button-secondary properties-toggle"
          type="button"
          aria-pressed="true"
          aria-label="Hide document list"
        >
          List
        </button>
        <button
          id="properties-toggle"
          class="ui-button button-primary properties-toggle"
          type="button"
          aria-pressed="false"
          aria-label="Open properties sidebar"
        >
          Sidebar
        </button>
      </div>
    </header>
    <textarea
      id="document-editor"
      class="document-editor"
      spellcheck="false"
      aria-label="Markdown source"
      hidden></textarea>
    <article id="document-body" class="reader-body empty-state">
      <div class="empty-card">
        <strong>Select a document</strong>
        Choose a folder and document to preview its Markdown content.
      </div>
    </article>
  </div>
</main>
