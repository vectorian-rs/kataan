---
import FolderNav from './FolderNav.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<aside class="sidebar">
  <div
    id="sidebar-resize-handle"
    class="column-resize-handle resize-inline-end"
    role="separator"
    aria-label="Resize navigation column"
    aria-orientation="vertical"
    tabindex="0"
  >
  </div>

  <div>
    <header class="panel-header app-header">
      <div>
        <div id="vault-summary" class="app-subtitle">Loading vault…</div>
      </div>
      <ThemeToggle />
    </header>

    <section class="search-panel" aria-label="Vault search">
      <form id="search-form" class="search-form">
        <label class="visually-hidden" for="search-input">Search vault</label>
        <input
          id="search-input"
          class="search-input"
          name="q"
          type="search"
          autocomplete="off"
          placeholder="Search vault…"
        />
      </form>
      <div id="search-status" class="search-status muted">Checking search index…</div>
    </section>

    <FolderNav />

    <section class="section">
      <h2 class="section-heading">Diagnostics</h2>
      <div id="diagnostics" class="list muted">No diagnostics yet.</div>
    </section>
  </div>

  <div class="toolbar">
    <button id="validate-button" class="ui-button button-secondary toolbar-button" type="button"
      >Validate</button
    >
    <button id="rebuild-button" class="ui-button button-primary toolbar-button" type="button"
      >Rebuild</button
    >
  </div>
</aside>
